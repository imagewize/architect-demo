msgid "Zes projectkaarten met opstand-tekening, beschrijving en meta. Komt uit de projecten-sectie van index.html."
msgstr ""

#: patterns/projecten.php:19
msgid "Geselecteerde projecten"
msgstr ""

#: patterns/projecten.php:23
msgid "Zes projecten uit 2019–2026 — van villa tot voormalige kerk."
msgstr ""

#: patterns/projecten.php:31
msgid "Villa Veldzicht"
msgstr ""

#: patterns/projecten.php:41
msgid "Opstand van Villa Veldzicht: glazen paviljoen onder een uitkragende dakplaat met verschoven bovenbouw, oranje voordeur, twee bomen en twee schaalfiguren."
msgstr ""

#: patterns/projecten.php:46
msgid "Villa rond een beschutte binnentuin, met de woonkamer gericht op de Kralingse Plas."
msgstr ""

#: patterns/projecten.php:50
msgid "Kralingen · Nieuwbouw villa · 2024"
msgstr ""

#: patterns/projecten.php:57
msgid "Woonblok Maashaven"
msgstr ""

#: patterns/projecten.php:67
msgid "Opstand van Woonblok Maashaven: vier verdiepingen met een raster van ramen, oranje dubbele entree op de begane grond, kade met water en een afgemeerd binnenvaartschip."
msgstr ""

#: patterns/projecten.php:72
msgid "24 appartementen in een gesloten blok aan het water, waarvan 18 sociale huur."
msgstr ""

#: patterns/projecten.php:76
msgid "Kop van Zuid · Woonblok · 2023"
msgstr ""

#: patterns/projecten.php:83
msgid "Pakhuis Keilewerf"
msgstr ""

#: patterns/projecten.php:93
msgid "Opstand van Pakhuis Keilewerf: pakhuis met trapgevel en metselverband, twee rijen kleine ramen, oranje laaddeur met hijsbalk, zaagdak-aanbouw en een binnenvaartschip aan de kade."
msgstr ""

#: patterns/projecten.php:98
msgid "Voormalig pakhuis met twaalf loftwoningen en vier ateliers op de begane grond."
msgstr ""

#: patterns/projecten.php:102
msgid "Merwe-Vierhavens (M4H) · Transformatie pakhuis · 2021"
msgstr ""

#: patterns/projecten.php:109
msgid "De Hoeksteen"
msgstr ""

#: patterns/projecten.php:119
msgid "Opstand van De Hoeksteen: voormalige kerk met schip en zadeldak, toren met spits, drie hoge vensters, oranje ingangsportaal, twee bomen en twee schaalfiguren."
msgstr ""

#: patterns/projecten.php:124
msgid "Voormalige kerk met acht woningen rond de lichtinval van het middenschip."
msgstr ""

#: patterns/projecten.php:128
msgid "Delfshaven · Kerk → woningen · 2019"
msgstr ""

#: patterns/projecten.php:135
msgid "Kadeblok Noordereiland"
msgstr ""

#: patterns/projecten.php:145
msgid "Opstand van Kadeblok Noordereiland: vier panden met zadeldaken aan de kade, twee ramen per verdieping, één oranje deur en een binnenvaartschip in het water."
msgstr ""

#: patterns/projecten.php:150
msgid "Negen kadewoningen met kap en uitzicht op de Maas, direct aan de kade."
msgstr ""

#: patterns/projecten.php:154
msgid "Noordereiland · 9 kadewoningen · 2022"
msgstr ""

#: patterns/projecten.php:161
msgid "De Bergweg"
msgstr ""

#: patterns/projecten.php:171
msgid "Opstand van De Bergweg: voormalige school, blok van 30 meter breed met zaagdak en schoorsteen, een lange band van tien ramen, oranje dubbele entree, twee bomen en twee schaalfiguren."
msgstr ""

#: patterns/projecten.php:176
msgid "Voormalige basisschool, nu tien appartementen en een buurthuis in de zijvleugel."
msgstr ""

#: patterns/projecten.php:180
msgid "Bergwegkwartier · School → wonen · 2020"
msgstr ""

