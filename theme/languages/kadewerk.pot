#: patterns/hero.php
msgctxt "Pattern description"
msgid "Hero van Bureau Kadewerk — kicker, titel, lead, acties, doorsnede-tekening en kerncijfers. Komt uit de hero-sectie van index.html."
msgstr ""

#: patterns/hero.php:19
msgid "Architectenbureau — Rotterdam, sinds 2009"
msgstr ""

#: patterns/hero.php:23
msgid "Precieze architectuur voor wonen en hergebruik."
msgstr ""

#: patterns/hero.php:27
msgid "Bureau Kadewerk is een team van twaalf architecten in Rotterdam. Wij ontwerpen villa’s en woonblokken — en geven pakhuizen, kerken en scholen een tweede leven als woning of werkplek."
msgstr ""

#: patterns/hero.php:38
msgid "Bekijk zes projecten"
msgstr ""

#: patterns/hero.php:45
msgid "Doorsnede door een bestaand pakhuis: zadeldak in zwart poche met oranje dakraam, gesneden kopwanden met een raam op elke verdieping en een deur, twee ingevoegde vloerplaten, een trap, een maatvoering van 16,0 m en drie schaalfiguren op drie niveaus."
msgstr ""

#: patterns/hero.php:45
msgid "Fig. 01 — Doorsnede bestaand pakhuis: gesneden zadeldak met oranje dakraam, kopwanden met ramen op elke verdieping en een deur, twee ingevoegde vloerplaten, trap, maatvoering 16,0 m en drie schaalfiguren op drie niveaus"
msgstr ""

